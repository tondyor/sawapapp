# ШАБЛОН для .env — копируй в .env и заполняй реальными значениями.
# Сам .env в git НЕ попадает (.gitignore). Здесь никогда не должно
# быть реальных ключей — только пустые плейсхолдеры.

# --- Telegram: бот ---
# API-токен бота: @BotFather → /mybots → <бот> → API Token
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=sawapapp

# --- Telegram Serverless: CLI access token ---
# @BotFather → твой бот → Serverless → CLI Access → Access token
# Формат: app<id>:<secret> (отличается от API-токена бота)
TGCLOUD_TOKEN=

# --- NVIDIA LLM API ---
# https://build.nvidia.com → Get API Key
# Endpoint: https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

{
  // Mini App hosting: build output of the Vite front-end
  "static": {
    "source": "dist",
    "spa": true,
    "immutable": ["/assets/*"],
    "headers": [
      { "path": "/", "set": { "Cache-Control": "no-cache, must-revalidate" } }
    ]
  },
  "$schema": "./node_modules/@tgcloud/cli/schema/tgcloud.json"
}
